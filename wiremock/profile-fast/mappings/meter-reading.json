{
  "mappings": [
    {
      "name": "fast 50-200 ms (100 %)",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPathPattern": "/meters/[^/]+/reading"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "reading.json",
        "transformers": [
          "response-template"
        ],
        "delayDistribution": {
          "type": "uniform",
          "lower": 50,
          "upper": 200
        }
      }
    }
  ]
}